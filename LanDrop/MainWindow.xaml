<Window x:Class="LanDrop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:LanDrop.ViewModels"
        Title="LanDrop"
        Height="500" Width="700"
        MinWidth="500" MinHeight="400"
        WindowStartupLocation="CenterScreen"
        Background="#1E1E2E"
        Foreground="#CDD6F4"
        MouseLeftButtonDown="Window_MouseLeftButtonDown"
        Closing="Window_Closing">
    <Window.DataContext>
        <vm:MainViewModel/>
    </Window.DataContext>
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Padding="12" CornerRadius="8" Background="#313244" Margin="0,0,0,12">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="LanDrop" FontSize="22" FontWeight="Bold" Foreground="#89B4FA"/>
                <TextBlock Text="  局域网快传" FontSize="14" Foreground="#A6ADC8" VerticalAlignment="Center"/>
            </StackPanel>
        </Border>

        <!-- Local Info -->
        <Border Grid.Row="1" Padding="12" CornerRadius="8" Background="#313244" Margin="0,0,0,12">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="本机: " FontSize="14" Foreground="#A6ADC8" VerticalAlignment="Center"/>
                <TextBlock Text="{Binding LocalName}" FontSize="14" FontWeight="Bold" Foreground="#A6E3A1" VerticalAlignment="Center"/>
                <TextBlock Text="  IP: " FontSize="13" Foreground="#585B70" VerticalAlignment="Center" Margin="12,0,0,0"/>
                <TextBlock Text="{Binding LocalIp}" FontSize="13" Foreground="#585B70" VerticalAlignment="Center"/>
            </StackPanel>
        </Border>

        <!-- Device List -->
        <Border Grid.Row="2" CornerRadius="8" Background="#181825" Padding="8">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="在线设备" FontSize="14" Foreground="#A6ADC8" Margin="4,0,0,8"/>

                <ListBox Grid.Row="1"
                         ItemsSource="{Binding Devices}"
                         SelectedItem="{Binding SelectedDevice}"
                         Background="Transparent"
                         BorderThickness="0"
                         AllowDrop="True"
                         Drop="DeviceList_Drop">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border Padding="10" Margin="4,2" CornerRadius="6" Background="#313244"
                                    ToolTip="{Binding DeviceKey}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Name}" FontSize="15" FontWeight="SemiBold"
                                                   Foreground="#CDD6F4"/>
                                        <TextBlock Text="{Binding DeviceKey}" FontSize="11"
                                                   Foreground="#585B70"/>
                                    </StackPanel>
                                    <Button Grid.Column="1" Content="发文件" Width="64" Height="28"
                                            Margin="6,0" FontSize="12"
                                            Background="#45475A" Foreground="#CDD6F4" BorderThickness="0"
                                            Cursor="Hand"
                                            Click="SendFileButton_Click"/>
                                    <Button Grid.Column="2" Content="发剪贴板" Width="72" Height="28"
                                            FontSize="12"
                                            Background="#45475A" Foreground="#F9E2AF" BorderThickness="0"
                                            Cursor="Hand"
                                            Click="SendClipboardButton_Click"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <!-- Empty State -->
                <TextBlock Grid.Row="1" Text="等待设备加入..."
                           FontSize="16" Foreground="#585B70"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           Visibility="{Binding Devices.Count, Converter={StaticResource ZeroToVisibleConverter}, FallbackValue=Visible}"/>
            </Grid>
        </Border>

        <!-- Status Bar -->
        <Border Grid.Row="3" Padding="10,6" CornerRadius="6" Background="#313244" Margin="0,12,0,0">
            <TextBlock Text="{Binding StatusText}" FontSize="12" Foreground="#A6ADC8"/>
        </Border>
    </Grid>
</Window>
